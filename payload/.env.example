# Copy to .env and protect it:  cp .env.example .env && chmod 600 .env
# Never commit .env. Values are read from the environment at run time.

# Optional: your contact address, appended to the User-Agent that the
# source probe and collector send (polite to feed publishers).
AOC_CONTACT=

# Email delivery (used from the email patch onward)
AOC_SMTP_HOST=smtp.gmail.com
AOC_SMTP_PORT=587
AOC_SMTP_USER=
AOC_SMTP_PASSWORD=
AOC_MAIL_FROM=
AOC_MAIL_TO=
